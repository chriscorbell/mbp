{
  "workbench.startupEditor": "none",
  "workbench.activityBar.location": "top",
  "editor.fontSize": 14,
  "files.autoSave": "afterDelay",
  "editor.fontFamily": "'JetBrainsMono Nerd Font'",
  "editor.wordWrap": "on",
  "chat.agent.maxRequests": 10000,
  "editor.formatOnPaste": true,
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "chat.tools.global.autoApprove": true,
  "chat.tools.edits.autoApprove": {
    "**/.vscode/*.json": true,
    "**/.git/**": true,
    "**/{package.json,server.xml,build.rs,web.config,.gitattributes,.env}": true,
    "**/*.{code-workspace,csproj,fsproj,vbproj,vcxproj,proj,targets,props}": true,
    "**/*.lock": true,
    "**/*-lock.{yaml,json}": true,
  },
  "chatgpt.followUpQueueMode": "steer",
  "chat.mcp.gallery.enabled": true,
  "redhat.telemetry.enabled": false,
  "markdown-preview-enhanced.previewTheme": "atom-dark.css",
  "chat.tools.terminal.outputLocation": "terminal",
  "editor.minimap.enabled": false,
  "terminal.integrated.initialHint": false,
  "editor.stickyScroll.enabled": false,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "terminal.integrated.stickyScroll.enabled": false,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "security.workspace.trust.untrustedFiles": "open",
  "claudeCode.preferredLocation": "panel",
  "chat.viewSessions.orientation": "stacked",
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.accessibilitySupport": "off",
  "window.titleBarStyle": "custom",
  "custom-ui-style.electron": {
    "frame": false,
  },
  "workbench.colorTheme": "Carbonfox",
  "vscode_vibrancy.theme": "Custom theme (use imports)",
  "vscode_vibrancy.type": "under-window",
  "vscode_vibrancy.opacity": 0.58,
  "vscode_vibrancy.backgroundOverride": "#161616",
  "vscode_vibrancy.windowMode": "auto",
  "vscode_vibrancy.preventFlash": true,
  "vscode_vibrancy.imports": [
    "/Users/chris/Library/Application Support/Code/User/vibrancy-carbonfox.css",
  ],
  "workbench.colorCustomizations": {
    "terminal.background": "#00000000",
    "editorPane.background": "#16161600",
    "editorGroupHeader.tabsBackground": "#16161600",
    "editorGroupHeader.noTabsBackground": "#16161600",
    "breadcrumb.background": "#16161600",
    "editorGutter.background": "#16161600",
    "panel.background": "#16161600",
    "panelStickyScroll.background": "#16161600",
    "tab.activeBackground": "#16161600",
    "tab.unfocusedActiveBackground": "#16161600",
    "sideBar.background": "#16161694",
    "sideBarTitle.background": "#16161694",
    "sideBarStickyScroll.background": "#16161694",
    "activityBar.background": "#16161694",
    "editor.background": "#16161694",
    "editorStickyScroll.background": "#16161694",
    "editorStickyScrollGutter.background": "#16161694",
    "tab.inactiveBackground": "#16161694",
    "tab.unfocusedInactiveBackground": "#16161694",
    "inlineChat.background": "#161616e6",
    "editorWidget.background": "#161616e6",
    "editorHoverWidget.background": "#161616e6",
    "editorSuggestWidget.background": "#161616e6",
    "notifications.background": "#161616e6",
    "notificationCenterHeader.background": "#161616e6",
    "menu.background": "#161616e6",
    "quickInput.background": "#161616e6"
  },
  "terminal.integrated.gpuAcceleration": "off",
  "window.systemColorTheme": "default",
  "window.autoDetectColorScheme": false,
}
